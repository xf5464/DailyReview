{
  "name": "daily-review",
  "version": "1.0.0",
  "private": true,
  "author": "xf5464",
  "description": "Global macro dashboard for Electron and GitHub Pages.",
  "main": "desktop/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "npm run build && electron .",
    "preview": "node scripts/serve.js",
    "desktop": "npm run build && electron .",
    "desktop:open": "electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "test": "node --test && node --check site/app.js && node --check site/service-worker.js && node --check scripts/build.js && node --check desktop/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.dailyreview.app",
    "productName": "Daily Review",
    "asar": true,
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Daily-Review-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "nodemailer": "^9.0.6"
  }
}
